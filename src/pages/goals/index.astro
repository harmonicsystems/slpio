---
import SectionIndexLayout from '../../layouts/SectionIndexLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('goals');

// Group by domain
const domainOrder = [
    'articulation-phonology', 'receptive-language', 'expressive-language',
    'pragmatics-social', 'dysphagia', 'cognitive-linguistic',
    'fluency', 'voice-resonance', 'aac', 'literacy',
];

const domainLabels: Record<string, string> = {
    'articulation-phonology': 'Articulation & Phonology',
    'receptive-language': 'Receptive Language',
    'expressive-language': 'Expressive Language',
    'pragmatics-social': 'Pragmatics & Social Communication',
    'dysphagia': 'Dysphagia',
    'cognitive-linguistic': 'Cognitive-Linguistic',
    'fluency': 'Fluency',
    'voice-resonance': 'Voice & Resonance',
    'aac': 'AAC',
    'literacy': 'Literacy',
};

const domainIcons: Record<string, string> = {
    'articulation-phonology': 'ph-duotone ph-waveform',
    'receptive-language': 'ph-duotone ph-ear',
    'expressive-language': 'ph-duotone ph-chat-circle',
    'pragmatics-social': 'ph-duotone ph-users',
    'dysphagia': 'ph-duotone ph-drop',
    'cognitive-linguistic': 'ph-duotone ph-brain',
    'fluency': 'ph-duotone ph-chat-dots',
    'voice-resonance': 'ph-duotone ph-microphone',
    'aac': 'ph-duotone ph-hand-pointing',
    'literacy': 'ph-duotone ph-book-open-text',
};

const domainColors: Record<string, string> = {
    'articulation-phonology': 'var(--primary)',
    'receptive-language': 'var(--accent-green)',
    'expressive-language': 'var(--accent-amber)',
    'pragmatics-social': '#7b2d8e',
    'dysphagia': 'var(--accent-red)',
    'cognitive-linguistic': 'var(--primary)',
    'fluency': 'var(--accent-green)',
    'voice-resonance': 'var(--accent-amber)',
    'aac': '#7b2d8e',
    'literacy': 'var(--primary)',
};

const supportColors: Record<string, string> = {
    'independent': 'var(--accent-green)',
    'minimal': 'var(--primary)',
    'moderate': 'var(--accent-amber)',
    'maximum': 'var(--accent-red)',
};

// Group entries by domain
const grouped = domainOrder
    .map(domain => ({
        domain,
        label: domainLabels[domain],
        icon: domainIcons[domain],
        entries: entries
            .filter(e => e.data.domain === domain)
            .sort((a, b) => a.data.order - b.data.order),
    }))
    .filter(g => g.entries.length > 0);
---

<SectionIndexLayout
    title="Goal <span class='accent'>Bank</span>"
    label="Clinical Reference"
    description="Measurable, evidence-referenced goals organized by domain. Every goal answers four questions: under what conditions, what observable behavior, to what measurable criteria, and how will you track it. These are starting points for individualization, never copy-paste solutions."
    reflection="Every goal here is measurable and evidence-referenced. Whether it's the right goal depends on things no bank can contain: the client's affect, the family's priorities, how the deficit presents in this specific context. Pristine structure is not the same as clinical fit."
>
    <div class="goal-legend">
        <span class="legend-item"><span class="legend-dot" style="background: var(--accent-green);"></span> Independent</span>
        <span class="legend-item"><span class="legend-dot" style="background: var(--primary);"></span> Minimal</span>
        <span class="legend-item"><span class="legend-dot" style="background: var(--accent-amber);"></span> Moderate</span>
        <span class="legend-item"><span class="legend-dot" style="background: var(--accent-red);"></span> Maximum</span>
        <span class="legend-item"><span class="legend-dot nd-dot"></span> ND-Affirming</span>
    </div>

    {grouped.map((group) => (
        <div class="domain-group" id={group.domain}>
            <h3 class="domain-heading">
                <i class={group.icon} style={`color: ${domainColors[group.domain]};`}></i>
                {group.label}
                <span class="domain-count">{group.entries.length} goals</span>
            </h3>
            <div class="goal-cards">
                {group.entries.map((entry) => (
                    <a href={`/goals/${entry.id}/`} class="nav-card goal-card">
                        <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.5rem;">
                            <span class="goal-tag" style={`background: ${supportColors[entry.data.supportLevel]}15; color: ${supportColors[entry.data.supportLevel]};`}>
                                {entry.data.supportLevel}
                            </span>
                            {entry.data.neurodiversityAffirming && (
                                <span class="goal-tag nd-tag">ND-affirming</span>
                            )}
                            <span class="goal-tag" style="background: var(--secondary); color: var(--text-muted);">
                                {entry.data.severity}
                            </span>
                        </div>
                        <h3>{entry.data.title}</h3>
                        <p>{entry.data.description}</p>
                        <div style="margin-top:0.5rem; font-size:0.7rem; color:var(--text-muted);">
                            {entry.data.settings.join(' · ')}
                            {entry.data.ageRange && ` · ${entry.data.ageRange}`}
                        </div>
                    </a>
                ))}
            </div>
        </div>
    ))}
</SectionIndexLayout>

<style>
    .goal-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 0.75rem 1rem;
        background: var(--secondary);
        border-radius: var(--radius);
        margin-bottom: 2rem;
        font-size: 0.72rem;
        font-family: 'Poppins', sans-serif;
        color: var(--text-muted);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .nd-dot {
        background: linear-gradient(135deg, #e74c3c, #e67e22, #f1c40f, #2ecc71, #3498db, #9b59b6);
    }

    .domain-group {
        margin-bottom: 2.5rem;
    }

    .domain-heading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
    }

    .domain-heading i { font-size: 1.1rem; }

    .domain-count {
        margin-left: auto;
        font-family: 'Poppins', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
    }

    .goal-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }

    .goal-tag {
        font-family: 'Poppins', sans-serif;
        font-size: 0.6rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 2px 8px;
        border-radius: 99px;
    }

    .nd-tag {
        background: linear-gradient(135deg, rgba(231,76,60,0.1), rgba(155,89,182,0.1));
        color: #7b2d8e;
    }

    @media (max-width: 768px) {
        .goal-cards { grid-template-columns: 1fr; }
    }
</style>
