---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptDemo from '../components/PromptDemo.astro';

// Build-time date. The site only rebuilds when content ships (push-triggered
// deploys), so the build month IS the last-updated month — and it can't lie.
const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<BaseLayout title="SLP + LLM Field Guide">
    <div class="hero-wrapper">
        <section class="hero">
            <div class="hero-content">
                <div class="hero-label">
                    <span class="pulse-dot"></span>
                    Actively maintained field guide
                </div>
                <h1>SLP + LLM<br/>Field Guide</h1>
                <p class="tagline">A free clinical knowledge resource for speech-language pathologists who use LLMs in their clinical writing — and want to get better at reading what comes back.</p>
                <div class="hero-questions">
                    <p class="hero-question"><span class="io-tag">I</span> How do I use LLMs well in my clinical writing?</p>
                    <p class="hero-question"><span class="io-tag io-tag-out">O</span> How do I tell when LLM writing is meeting the client — and when it isn't?</p>
                </div>

                <div class="io-explainer">
                    <p>
                        <strong>I/O</strong> = <em>input/output</em>. In computing, how a system receives and sends information. In SLP, what we study every day: how people take in language and produce it. This guide covers both directions — writing the input, reading the output.
                    </p>
                </div>

                <div class="hero-cta">
                    <a class="btn-primary" href="/foundations/">Read the foundations</a>
                    <a href="/reading/" class="link-arrow">Reading LLM writing →</a>
                </div>

                <div class="hero-meta">
                    <span><i class="ph-duotone ph-stethoscope"></i> Built by a clinician</span>
                    <span><i class="ph-duotone ph-scales"></i> Aligned with ASHA ethics</span>
                    <span><i class="ph-duotone ph-waveform"></i> A Harmonic Systems project</span>
                    <span><i class="ph-duotone ph-arrows-clockwise"></i> Last updated {lastUpdated}</span>
                </div>
            </div>
        </section>
    </div>

    <div class="section-divider"><hr/></div>

    <!-- ── Quick Start ── -->
    <section>
        <div class="section-header">
            <div class="section-label">New here?</div>
            <h2>Start <span class="accent">Here</span></h2>
            <p class="section-intro">This isn't about learning to use LLMs. It's about articulating what you already know (your clinical expertise) clearly enough that any tool can work with it.</p>
        </div>

        <div class="quickstart-steps">
            <a href="/foundations/phi-safety/" class="quickstart-step">
                <div class="quickstart-number">1</div>
                <div class="quickstart-content">
                    <h4>Protect Patient Data</h4>
                    <p>Learn what can and cannot go into an LLM. Use the PHI safety checker to build good habits from day one.</p>
                </div>
                <i class="ph ph-arrow-right quickstart-arrow"></i>
            </a>
            <a href="/foundations/prompt-patterns/" class="quickstart-step">
                <div class="quickstart-number">2</div>
                <div class="quickstart-content">
                    <h4>Learn the Anatomy of a Clinical Prompt</h4>
                    <p>Six structural moves that operationalize your clinical knowledge so it translates into better LLM output.</p>
                </div>
                <i class="ph ph-arrow-right quickstart-arrow"></i>
            </a>
            <a href="/tasks/writing-goals/" class="quickstart-step">
                <div class="quickstart-number">3</div>
                <div class="quickstart-content">
                    <h4>Write Your First Goal</h4>
                    <p>Put it into practice. The specificity of the output depends entirely on the clinical knowledge you bring to it.</p>
                </div>
                <i class="ph ph-arrow-right quickstart-arrow"></i>
            </a>
        </div>
    </section>

    <div class="section-divider"><hr/></div>

    <!-- ── Interactive Demo ── -->
    <PromptDemo />

    <div class="section-divider"><hr/></div>

    <!-- ── Explore the Guide ── -->
    <section>
        <div class="section-header">
            <div class="section-label">Explore</div>
            <h2>Find What You <span class="accent">Need</span></h2>
            <p class="section-intro">Enter from any angle. The guide is organized around four questions: What do I need to know? What am I trying to do? Where do I work? Did I do it right?</p>
        </div>

        <!-- LEARN -->
        <div class="group-label"><i class="ph-duotone ph-book-open"></i> Learn</div>
        <div class="layer-grid">
            <a href="/foundations/" class="layer-card">
                <div class="layer-icon"><i class="ph-duotone ph-compass"></i></div>
                <h3>Foundations</h3>
                <p>Core principles, PHI safety, how LLMs work, prompt patterns, evidence base, ethical decision trees, and model comparison.</p>
                <span class="layer-count">8 guides</span>
            </a>

            <a href="/glossary/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, var(--accent-amber), #e67e22);"><i class="ph-duotone ph-translate"></i></div>
                <h3>Glossary</h3>
                <p>Every term defined from both sides, clinical and technical. SLPs and developers finally speaking the same language.</p>
                <span class="layer-count">25 terms</span>
            </a>

            <a href="/research/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, #2c3e50, #34495e);"><i class="ph-duotone ph-article"></i></div>
                <h3>Research Digests</h3>
                <p>Structured summaries of peer-reviewed studies on LLMs in healthcare and clinical documentation, focusing on what the evidence actually says.</p>
                <span class="layer-count">6 studies</span>
            </a>
        </div>

        <!-- DO -->
        <div class="group-label"><i class="ph-duotone ph-hammer"></i> Do</div>
        <div class="layer-grid">
            <a href="/goals/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, #e67e22, var(--accent-amber));"><i class="ph-duotone ph-target"></i></div>
                <h3>Goal Bank</h3>
                <p>Measurable, evidence-referenced goals organized by domain. Every goal answers four questions and includes individualization guidance. Starting points, not copy-paste solutions.</p>
                <span class="layer-count">Growing collection</span>
            </a>

            <a href="/prompts/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, var(--accent-green), #2ecc71);"><i class="ph-duotone ph-terminal-window"></i></div>
                <h3>Prompt Library</h3>
                <p>Each prompt is an inventory of what a competent clinician knows (assessment frameworks, legal requirements, clinical reasoning) made actionable.</p>
                <span class="layer-count">12 prompts</span>
            </a>

            <a href="/tasks/" class="layer-card">
                <div class="layer-icon"><i class="ph-duotone ph-clipboard-text"></i></div>
                <h3>Tasks</h3>
                <p>Goal writing, documentation, communication, compliance, clinical reasoning, and material creation — each with its multi-step workflows and matching prompts.</p>
                <span class="layer-count">6 tasks · 6 workflows</span>
            </a>
        </div>

        <!-- ADAPT -->
        <div class="group-label"><i class="ph-duotone ph-sliders-horizontal"></i> Adapt</div>
        <div class="layer-grid">
            <a href="/settings/" class="layer-card">
                <div class="layer-icon"><i class="ph-duotone ph-buildings"></i></div>
                <h3>Settings</h3>
                <p>Schools, medical/acute, SNF/rehab, early intervention, private practice, and university supervision.</p>
                <span class="layer-count">6 settings</span>
            </a>

            <a href="/domains/" class="layer-card">
                <div class="layer-icon"><i class="ph-duotone ph-circles-four"></i></div>
                <h3>Domains</h3>
                <p>Articulation, language, fluency, voice, pragmatics, cognitive-linguistic, dysphagia, AAC, literacy, and hearing.</p>
                <span class="layer-count">10 domains</span>
            </a>

            <a href="/patterns/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, #7b2d8e, #9b59b6);"><i class="ph-duotone ph-tree-structure"></i></div>
                <h3>Clinical Patterns</h3>
                <p>Map your clinical philosophy to LLM interaction strategies. Naturalistic, discrete trial, family-centered; each approach is different.</p>
                <span class="layer-count">6 patterns</span>
            </a>
        </div>

        <!-- VERIFY -->
        <div class="group-label"><i class="ph-duotone ph-check-square"></i> Verify</div>
        <div class="layer-grid">
            <a href="/reading/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, #2c3e50, #34495e);"><i class="ph-duotone ph-eyeglasses"></i></div>
                <h3>Reading LLM Writing</h3>
                <p>Learn to read LLM-generated clinical text the way you'd read a student clinician's draft — including eight worked antipatterns: output that looks plausible and fails clinically.</p>
                <span class="layer-count">The skill + 8 antipatterns</span>
            </a>

            <a href="/case-studies/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, var(--accent-green), #27ae60);"><i class="ph-duotone ph-users-three"></i></div>
                <h3>Case Studies</h3>
                <p>De-identified clinical scenarios showing real SLP workflows with LLMs: what worked, what failed, and lessons learned.</p>
                <span class="layer-count">5 cases</span>
            </a>

            <a href="/policies/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, #7b2d8e, #9b59b6);"><i class="ph-duotone ph-shield-check"></i></div>
                <h3>Policy Templates</h3>
                <p>Adaptable LLM governance templates for schools, hospitals, private practices, and clinical education programs.</p>
                <span class="layer-count">4 templates</span>
            </a>

            <a href="/ai-updates/" class="layer-card">
                <div class="layer-icon" style="background: linear-gradient(135deg, var(--accent-amber), #e67e22);"><i class="ph-duotone ph-bell-ringing"></i></div>
                <h3>AI Updates</h3>
                <p>Breaking changes, privacy updates, and policy shifts for ChatGPT, Claude, Gemini, DeepSeek, and other tools SLPs use. What changed and what to do about it.</p>
                <span class="layer-count">Rolling feed</span>
            </a>

            <a href="/resources/" class="layer-card">
                <div class="layer-icon"><i class="ph-duotone ph-book-open-text"></i></div>
                <h3>Resources</h3>
                <p>Digital media literacy, full references, changelog, and supporting materials.</p>
                <span class="layer-count">3 resources</span>
            </a>
        </div>
    </section>

    <div class="section-divider"><hr/></div>

    <!-- ── Origin ── -->
    <section class="section-alt">
        <div class="section-header">
            <div class="section-label">Origin</div>
            <h2>Why This <span class="accent">Exists</span></h2>
            <p class="section-intro">SLPs spend more time on paperwork than almost any other clinical task. LLM-assisted clinical writing is real work that deserves real craft — both in producing the artifact and in reading it critically against the actual client.</p>
        </div>

        <div class="card-grid">
            <div class="origin-card">
                <i class="ph-duotone ph-puzzle-piece"></i>
                <h4>The Gap</h4>
                <p>LLM-assisted documentation is becoming part of clinical practice. That work deserves the same rigor as any clinical skill — including the ability to read what a model produces and know where it meets the client and where it doesn't.</p>
            </div>
            <div class="origin-card">
                <i class="ph-duotone ph-code"></i>
                <h4>The Background</h4>
                <p>This resource is built by a school-based speech-language pathologist in New York who also writes software. That dual lens — clinical practice and software development — drives everything here.</p>
            </div>
            <div class="origin-card">
                <i class="ph-duotone ph-warning-circle"></i>
                <h4>The Problem</h4>
                <p>Paperwork is where clinical knowledge becomes a legal document. If new tools are going to touch that process, clinicians (not vendors) need to define the standards.</p>
            </div>
            <div class="origin-card">
                <i class="ph-duotone ph-target"></i>
                <h4>The Position</h4>
                <p>SLP/IO isn't pro-LLM or anti-LLM. It's pro-clinician. This resource is free because the knowledge it organizes already belongs to the profession. We're just making it easier to use.</p>
            </div>
        </div>

        <div class="origin-statement">
            <strong>Harmonic Systems</strong> is the studio behind SLP/IO, a small operation where clinical practice and software development overlap. SLP/IO is its first public resource: a living document where the rigor of speech-language pathology meets the capability of modern language models.
        </div>
    </section>

    <div class="section-divider"><hr/></div>

    <!-- ── Sustainability ── -->
    <section id="sustainability">
        <div class="section-header">
            <div class="section-label">Sustainability</div>
            <h2>Prompts Worth <span class="accent">the Water</span></h2>
            <p class="section-intro">Every AI query costs electricity and water. A shared, maintained reference is a better use of resources than thousands of clinicians asking chatbots the same questions independently. When you do use an LLM, make it count.</p>
        </div>

        <div class="sustainability-grid">
            <div class="sustain-card bad">
                <h4><i class="ph-duotone ph-drop"></i> Low-Value Use</h4>
                <ul>
                    <li>Asking "what are good IEP goals for articulation?" (this already exists everywhere)</li>
                    <li>Pasting one progress note and asking AI to "make it sound better"</li>
                    <li>Generating generic parent letters you'll rewrite anyway</li>
                    <li>Running the same prompt every session instead of saving a reusable template</li>
                    <li>Using a chatbot as a search engine for information in your own files</li>
                </ul>
            </div>
            <div class="sustain-card good">
                <h4><i class="ph-duotone ph-lightbulb"></i> High-Value Use</h4>
                <ul>
                    <li>Correlating a semester of progress notes to identify patterns across goals</li>
                    <li>Building a reusable documentation guide for your setting that you use all year</li>
                    <li>Reframing deficit-based language into strengths-based, neurodiversity-affirming descriptions</li>
                    <li>Synthesizing research across multiple sources into a team evidence summary</li>
                    <li>Drafting complex medical necessity arguments with your specific clinical data</li>
                </ul>
            </div>
        </div>

        <div class="sustain-callout">
            <p><strong>The position:</strong> Being thoughtful about AI isn't just about clinical ethics. It's about resource ethics. Reformatting a three-line note isn't worth the compute. Surfacing patterns across a semester of data, or finding language that honors a student's dignity while meeting legal documentation requirements — that's worth it.</p>
        </div>
    </section>

    <div class="section-divider"><hr/></div>

    <!-- ── About ── -->
    <section id="about">
        <div class="section-header">
            <div class="section-label">Background</div>
            <h2>About <span class="accent">This Resource</span></h2>
        </div>
        <div class="about-text">
            <p>SLP/IO is a <strong>Harmonic Systems</strong> project, built by a speech-language pathologist and software developer who has spent years writing the same IEP goals, progress notes, and evaluation reports that you write.</p>
            <p>This resource is free, independent, and not affiliated with any vendor or institution. The knowledge inside it isn't new — it's what competent clinicians already know, organized in a way that makes it usable with modern tools and readable with a critical eye.</p>
            <p>LLM-assisted clinical writing is real work that deserves real craft. The question was never "should SLPs use LLMs?" It's "who defines what good looks like, and who notices when it doesn't?" The answer should be clinicians.</p>
            <p class="ai-note">This resource was developed with LLM writing tools and reviewed through clinical judgment.</p>
        </div>
        <div class="disclosure">
            <strong>About Harmonic Systems:</strong> A small, independent studio in the Hudson Valley region of New York, built by a school-based speech-language pathologist who also writes software. SLP/IO is an attempt to bridge the gap between what clinicians need and what the technology conversation currently offers.
        </div>
    </section>

    <div class="section-divider"><hr/></div>

    <!-- ── Contact ── -->
    <section class="section-alt" id="contact">
        <div class="section-header">
            <div class="section-label">Connect</div>
            <h2>Get <span class="accent">Involved</span></h2>
        </div>
        <div class="cta-section">
            <h3>Want to contribute, collaborate, or push back?</h3>
            <p>This guide gets better when clinicians challenge it. If you've found a use case we missed, a principle that needs nuance, or something that's flat-out wrong, that's exactly the kind of feedback that matters.</p>
            <p>Have an LLM-generated clinical artifact you've been thinking about? <a href="/reading/#submit">Submit a specimen</a> — your noticings help build the field's shared vocabulary for reading AI-assisted clinical writing.</p>
            <a class="btn-primary" href="mailto:harmonicsystems.io@gmail.com">Send feedback</a>
        </div>
    </section>
</BaseLayout>

<style>
    /* ── Hero ── */
    .hero-wrapper {
        background: linear-gradient(135deg, var(--light) 0%, var(--primary-light) 50%, var(--secondary) 100%);
        position: relative;
        overflow: hidden;
    }

    .hero {
        max-width: 960px;
        margin: auto;
        min-height: calc(90vh - var(--header-height));
        display: flex;
        align-items: center;
        padding: 4rem 2rem;
        position: relative;
    }

    .hero-cta {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .hero-content { position: relative; z-index: 1; max-width: 720px; }

    .hero-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1.25rem;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: var(--accent-green);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(39,174,96,0.4); }
        50% { opacity: 0.8; box-shadow: 0 0 0 8px rgba(39,174,96,0); }
    }

    .tagline {
        font-size: 1.05rem;
        color: var(--text-muted);
        line-height: 1.7;
        margin-bottom: 1.75rem;
        font-family: 'Poppins', sans-serif;
    }

    .hero-questions {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        margin-bottom: 1.75rem;
    }

    .hero-question {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        font-family: 'Poppins', sans-serif;
        font-size: 1.02rem;
        font-weight: 500;
        color: var(--dark);
        line-height: 1.55;
        margin: 0;
    }

    .io-tag {
        flex-shrink: 0;
        width: 1.55rem;
        height: 1.55rem;
        margin-top: 0.05rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Roboto Mono', monospace;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--primary);
        border: 1.5px solid currentColor;
        border-radius: 6px;
    }

    .io-tag-out { color: var(--accent-green); }

    .io-explainer {
        margin-bottom: 2rem;
        padding: 0.9rem 1.25rem;
        border-left: 3px solid var(--primary);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        background: color-mix(in srgb, var(--secondary) 70%, transparent);
    }

    .io-explainer p {
        font-size: 0.85rem;
        line-height: 1.7;
        color: var(--text-muted);
        margin: 0;
    }

    .io-explainer strong {
        color: var(--dark);
        font-family: 'Roboto Mono', monospace;
        font-size: 0.82em;
    }

    .link-arrow {
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--primary);
        text-decoration: none;
        border-bottom: 2px solid var(--primary);
        padding-bottom: 2px;
    }

    .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.5rem;
        font-size: 0.78rem;
        color: var(--text-muted);
        font-family: 'Poppins', sans-serif;
        margin-top: 2.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
    }

    .hero-meta span { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
    .hero-meta i { color: var(--primary); }

    /* ── Group Labels ── */
    .group-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Poppins', sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--primary);
        margin-top: 2.5rem;
        margin-bottom: 0.25rem;
        padding-left: 2px;
    }

    .group-label i { font-size: 1rem; }

    /* ── Layer Navigation Grid ── */
    .layer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
        margin-top: 2rem;
    }

    .layer-card {
        padding: 1.75rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-organic);
        transition: all var(--transition);
        box-shadow: var(--card-shadow);
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
    }

    .layer-card:nth-child(even) { border-radius: 4px 10px 4px 10px; }

    .layer-card:hover {
        border-color: var(--primary);
        box-shadow: var(--card-shadow-hover);
        transform: translateY(-4px);
        color: inherit;
    }

    .layer-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1rem;
        color: var(--light);
        background: linear-gradient(135deg, var(--primary), #3498db);
    }

    .layer-card h3 { font-size: 1rem; margin-bottom: 0.4rem; }
    .layer-card p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 0.75rem; }

    .layer-count {
        font-family: 'Poppins', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--primary);
    }

    /* ── Origin Cards ── */
    .origin-card {
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-organic);
        transition: all var(--transition);
        box-shadow: var(--card-shadow);
    }

    .origin-card:nth-child(even) { border-radius: 4px 10px 4px 10px; }

    .origin-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--card-shadow-hover);
    }

    .origin-card i { font-size: 1.3rem; color: var(--primary); margin-bottom: 0.75rem; display: block; }
    .origin-card h4 { font-size: 0.92rem; margin-bottom: 0.35rem; }
    .origin-card p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }

    .origin-statement {
        margin-top: 2rem;
        padding: 1.75rem;
        background: linear-gradient(135deg, var(--primary-light) 0%, rgba(52,152,219,0.05) 100%);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        border-left: 4px solid var(--primary);
        font-size: 0.9rem;
        line-height: 1.8;
        color: var(--text-muted);
    }

    .origin-statement strong { color: var(--dark); }

    /* ── About ── */
    .about-text { font-size: 0.92rem; line-height: 1.85; color: var(--text-muted); }
    .about-text p { margin-bottom: 1rem; }
    .ai-note { font-size: 0.82rem; font-style: italic; color: var(--text-muted); opacity: 0.8; }

    .disclosure {
        background: color-mix(in srgb, var(--secondary) 70%, transparent);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        padding: 1rem 1.25rem;
        margin-top: 1.5rem;
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.7;
        border-left: 3px solid var(--border);
    }

