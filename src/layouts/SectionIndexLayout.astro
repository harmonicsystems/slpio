---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  label?: string;
  reflection?: string;
}

const { title, description, label, reflection } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <section>
        <div class="section-header">
            {label && <div class="section-label">{label}</div>}
            <h2><Fragment set:html={title} /></h2>
            {description && <p class="section-intro">{description}</p>}
            {reflection && <p class="section-reflection">{reflection}</p>}
        </div>

        <div class="card-grid" style="margin-top: 2rem;">
            <slot />
        </div>
    </section>
</BaseLayout>

<style>
    .section-reflection {
        font-size: 0.85rem;
        color: var(--text-muted);
        border-left: 2px solid var(--border);
        padding-left: 1rem;
        margin-top: 0.75rem;
        max-width: 640px;
        line-height: 1.6;
        font-style: italic;
    }
</style>
