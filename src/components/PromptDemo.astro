/**
 * Interactive prompt demo: shows pre-generated SLP prompt/response examples
 * with a typewriter animation. Zero API calls; pure CSS + vanilla JS.
 */

const demos = [
    {
        label: 'Progress Note',
        prompt: 'I am a school-based SLP. Here are my raw session notes (no identifying info): worked on /s/ blends today, still struggling with initial position, used minimal pairs, about 60% accuracy with verbal cues, seemed frustrated toward end of session, mom asked about home practice. Organize into a structured progress note with: target skill, activity, performance data, clinical observations, and follow-up. Do not add details I did not provide.',
        response: `**Target:** /s/ blends, initial position

**Activity:** Minimal pair contrasts

**Performance:** 60% accuracy with verbal cueing

**Clinical Observation:** Student appeared frustrated toward end of session.

**Follow-up:** Parent asked about home practice.

*Note: The AI organized and labeled your observations. It did not interpret the frustration, suggest a cause, add a recommendation, or invent follow-up actions. Those decisions are yours.*`,
    },
    {
        label: 'IEP Goal Check',
        prompt: 'Review this IEP goal and tell me: (1) Is it observable? (2) Is it measurable with clear criteria? (3) Does it specify conditions and supports? (4) Could another clinician act on it immediately? If any answer is no, suggest a revision. Goal: "Student will demonstrate enhanced pragmatic communication abilities in various social contexts throughout the school day."',
        response: `**1. Observable?** No. "Enhanced pragmatic communication abilities" is not an observable behavior. What specific action would you watch for?

**2. Measurable?** No. There is no accuracy criterion, frequency count, or data collection method specified.

**3. Conditions and supports?** No. "Various social contexts" is undefined. "Throughout the school day" is not a condition; it is a time frame with no structure.

**4. Could another clinician act on it immediately?** No. A substitute SLP reading this goal would not know what to target, what to count, or when the student has met it.

**Suggested revision:** During structured small-group activities with 1 verbal prompt, [Student] will initiate a topic-relevant comment or question directed at a peer in 4 out of 5 opportunities across 3 consecutive sessions, as measured by SLP observation and data collection.

*Note: This goal was flagged on all four criteria. The revision adds a specific behavior (initiate a comment/question), a context (small-group), a support level (1 verbal prompt), measurable criteria (4/5 opportunities), and a measurement method.*`,
    },
    {
        label: 'Strengths Reframe',
        prompt: 'I am an SLP writing present levels. Help me describe these observations in language that is clinically accurate for an IEP, neurodiversity-affirming, and recognizes the function of the behavior. Do not minimize impact on participation. Observations: student talks at length about trains during group activities, has difficulty shifting to peer-selected topics, becomes upset when routines change unexpectedly.',
        response: `**"Talks at length about trains during group activities"**
→ [Student] demonstrates deep, focused engagement with preferred topics (transportation systems) and can sustain extended discourse on subjects of personal interest. During group activities, this strength can be leveraged for narrative and expository language targets. Currently, extended focus on preferred topics limits reciprocal exchange with peers during unstructured group interactions.

**"Has difficulty shifting to peer-selected topics"**
→ [Student] shows strong topic maintenance and sustained attention within areas of interest. Topic flexibility during peer-led conversations is an emerging skill. [Student] currently requires support (visual cue or verbal prompt) to transition between topics during collaborative activities.

**"Becomes upset when routines change unexpectedly"**
→ [Student] demonstrates strong awareness of expected routines and benefits from predictable structure. Unexpected schedule changes are a source of dysregulation. With advance notice and visual supports, [Student] can navigate transitions more independently.

*Note: Each description names the strength and the challenge. "Restricted interests" becomes focused engagement that can be leveraged for goals. "Rigidity" becomes predictability preference that responds to supports. The language is honest about participation impact while seeing the whole person.*`,
    },
    {
        label: 'Therapy Materials',
        prompt: 'Create 5 minimal pair cards for a child working on /k/ vs /t/ contrast in initial position. Make them kid-friendly with simple words.',
        response: `**Minimal Pair Cards: /k/ vs /t/ (Initial Position)**

| /k/ word | /t/ word | Visual Cue Idea |
|----------|----------|-----------------|
| **cap**  | **tap**  | baseball cap → water faucet |
| **key**  | **tea**  | gold key → teacup |
| **corn** | **torn** | ear of corn → ripped paper |
| **came** | **tame** | person arriving → gentle kitten |
| **coat** | **tote** | winter coat → tote bag |

**How to use these:**
1. Lay both cards face-up. Say one word; child points to the correct picture
2. Child says the word; you point to which one you heard (gives natural feedback)
3. If they say "tap" but mean "cap," pick up the faucet card to show why the difference matters

**Tip:** Start with the pairs where the pictures are most visually distinct (key/tea, corn/torn) before moving to harder contrasts.`,
    },
];
---

<div class="demo-section">
    <div class="section-header">
        <div class="section-label">See It In Action</div>
        <h2>Interactive <span class="accent">Demo</span></h2>
        <p class="section-intro">Watch how a well-crafted prompt produces clinically useful output. These are pre-generated examples: no API calls, no data sent anywhere.</p>
    </div>

    <div class="demo-container" id="prompt-demo">
        <div class="demo-tabs" id="demo-tabs">
            {demos.map((d, i) => (
                <button class={`demo-tab ${i === 0 ? 'active' : ''}`} data-index={i}>
                    {d.label}
                </button>
            ))}
        </div>

        <div class="demo-window">
            <div class="demo-toolbar">
                <div class="demo-dots">
                    <span class="dot red"></span>
                    <span class="dot yellow"></span>
                    <span class="dot green"></span>
                </div>
                <div class="demo-toolbar-title">SLP/IO Prompt Demo</div>
                <div class="demo-toolbar-spacer"></div>
            </div>

            <div class="demo-body">
                <div class="demo-prompt-section">
                    <div class="demo-role"><i class="ph ph-user"></i> Clinician</div>
                    <div class="demo-prompt-text" id="demo-prompt"></div>
                </div>

                <div class="demo-divider">
                    <span class="demo-divider-dot"></span>
                    <span class="demo-divider-dot"></span>
                    <span class="demo-divider-dot"></span>
                </div>

                <div class="demo-response-section">
                    <div class="demo-role ai"><i class="ph ph-robot"></i> AI Response <span class="demo-badge">requires clinical review</span></div>
                    <div class="demo-response-text" id="demo-response"></div>
                    <div class="demo-cursor" id="demo-cursor"></div>
                </div>

                <div class="demo-start-overlay" id="demo-start-overlay">
                    <button class="demo-start-btn" id="demo-start-btn">
                        <i class="ph ph-play-circle"></i> Run this prompt
                    </button>
                </div>
            </div>

            <div class="demo-footer-bar">
                <button class="demo-replay-btn" id="demo-replay" disabled>
                    <i class="ph ph-play"></i> Replay
                </button>
                <div class="demo-disclaimer">Pre-generated example, not live AI output</div>
            </div>
        </div>
    </div>
</div>

<script is:inline define:vars={{ demos }}>
(function() {
    let currentIndex = 0;
    let animationId = null;
    let promptTimeout = null;
    let hasStarted = false;

    const promptEl = document.getElementById('demo-prompt');
    const responseEl = document.getElementById('demo-response');
    const cursorEl = document.getElementById('demo-cursor');
    const tabs = document.querySelectorAll('.demo-tab');
    const replayBtn = document.getElementById('demo-replay');
    const startOverlay = document.getElementById('demo-start-overlay');
    const startBtn = document.getElementById('demo-start-btn');

    function clearAnimation() {
        if (animationId) cancelAnimationFrame(animationId);
        if (promptTimeout) clearTimeout(promptTimeout);
        animationId = null;
        promptTimeout = null;
    }

    function typeText(element, text, speed, callback) {
        let i = 0;
        element.innerHTML = '';
        cursorEl.style.display = 'inline-block';

        function tick() {
            if (i < text.length) {
                let char = text[i];
                i++;
                element.innerHTML = formatMarkdown(text.slice(0, i));
                element.closest('.demo-body').scrollTop = element.closest('.demo-body').scrollHeight;

                let delay = speed;
                if (char === '\n') delay = speed * 2;
                else if (char === '.' || char === '!' || char === '?') delay = speed * 1.5;
                else if (char === ',') delay = speed * 1.2;
                else if (char === '*') delay = 0;

                promptTimeout = setTimeout(() => {
                    animationId = requestAnimationFrame(tick);
                }, delay);
            } else {
                cursorEl.style.display = 'none';
                if (callback) callback();
            }
        }
        tick();
    }

    function formatMarkdown(text) {
        return text
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/\|(.+)\|/g, function(match) {
                if (match.match(/^\|\s*[-:]+/)) return '<div class="md-table-sep"></div>';
                const cells = match.split('|').filter(c => c.trim()).map(c => '<span class="md-cell">' + c.trim() + '</span>');
                return '<div class="md-table-row">' + cells.join('') + '</div>';
            })
            .replace(/^(\d+)\.\s(.+)$/gm, '<div class="md-li"><span class="md-num">$1.</span> $2</div>')
            .replace(/\n/g, '<br/>');
    }

    function showPrompt(index) {
        currentIndex = index;
        const demo = demos[index];
        tabs.forEach((t, i) => t.classList.toggle('active', i === index));
        promptEl.textContent = demo.prompt;
        responseEl.innerHTML = '';
        cursorEl.style.display = 'none';

        if (!hasStarted) {
            startOverlay.style.display = 'flex';
            replayBtn.disabled = true;
        }
    }

    function runDemo(index) {
        clearAnimation();
        hasStarted = true;
        currentIndex = index;
        const demo = demos[index];

        tabs.forEach((t, i) => t.classList.toggle('active', i === index));
        startOverlay.style.display = 'none';
        replayBtn.disabled = false;

        promptEl.textContent = demo.prompt;
        responseEl.innerHTML = '';
        cursorEl.style.display = 'inline-block';

        promptTimeout = setTimeout(() => {
            typeText(responseEl, demo.response, 3, null);
        }, 400);
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            if (hasStarted) {
                runDemo(parseInt(tab.dataset.index));
            } else {
                showPrompt(parseInt(tab.dataset.index));
            }
        });
    });

    startBtn.addEventListener('click', () => {
        runDemo(currentIndex);
    });

    replayBtn.addEventListener('click', () => {
        runDemo(currentIndex);
    });

    // Show first prompt (but don't animate) on load
    showPrompt(0);
})();
</script>

